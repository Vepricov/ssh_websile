#!/usr/bin/python3
import ctypes
import os
import pwd
import re
import signal
import sys
from pathlib import Path


USERNAME_RE = re.compile(r"^[a-z_][a-z0-9_-]{0,31}$")
IDENTITY_RE = re.compile(r"^([0-9]+):([1-9][0-9]*)$")
LIBC = ctypes.CDLL(None, use_errno=True)
SYS_PIDFD_SEND_SIGNAL = 424
SYS_PIDFD_OPEN = 434


def fail(message: str) -> None:
    print(message, file=sys.stderr)
    raise SystemExit(2)


def process_identity(pid: int, expected_uid: int) -> tuple[int, int] | None:
    proc = Path("/proc") / str(pid)
    try:
        status = (proc / "status").read_text()
        stat = (proc / "stat").read_text()
    except (FileNotFoundError, ProcessLookupError):
        return None
    uid_line = next((line for line in status.splitlines() if line.startswith("Uid:")), "")
    uid_fields = uid_line.split()
    if len(uid_fields) < 2 or int(uid_fields[1]) != expected_uid:
        fail(f"PID {pid} is not owned by the requested user")
    closing_parenthesis = stat.rfind(")")
    fields = stat[closing_parenthesis + 2 :].split()
    if closing_parenthesis < 0 or len(fields) <= 19:
        fail(f"PID {pid} has invalid proc metadata")
    return pid, int(fields[19])


def parse_username(value: str) -> tuple[str, int]:
    if not USERNAME_RE.fullmatch(value):
        fail("invalid username")
    try:
        account = pwd.getpwnam(value)
    except KeyError:
        fail("unknown username")
    return value, account.pw_uid


def pidfd_open(pid: int) -> int:
    if hasattr(os, "pidfd_open"):
        return os.pidfd_open(pid)
    descriptor = LIBC.syscall(SYS_PIDFD_OPEN, pid, 0)
    if descriptor < 0:
        error = ctypes.get_errno()
        raise OSError(error, os.strerror(error))
    return descriptor


def pidfd_send_signal(descriptor: int, signal_number: int) -> None:
    if hasattr(signal, "pidfd_send_signal"):
        signal.pidfd_send_signal(descriptor, signal_number)
        return
    result = LIBC.syscall(
        SYS_PIDFD_SEND_SIGNAL,
        descriptor,
        signal_number,
        ctypes.c_void_p(),
        0,
    )
    if result < 0:
        error = ctypes.get_errno()
        raise OSError(error, os.strerror(error))


def inspect(username: str, arguments: list[str]) -> None:
    _, uid = parse_username(username)
    if not arguments or any(not value.isdigit() or int(value) <= 1 for value in arguments):
        fail("invalid PID list")
    for pid in sorted(set(int(value) for value in arguments)):
        identity = process_identity(pid, uid)
        if identity is not None:
            print(f"{identity[0]}:{identity[1]}")


def send_signal(action: str, username: str, arguments: list[str]) -> None:
    _, uid = parse_username(username)
    if not arguments:
        fail("missing process identities")
    expected = []
    for value in arguments:
        match = IDENTITY_RE.fullmatch(value)
        if match is None:
            fail("invalid process identity")
        pid = int(match.group(1))
        if pid <= 1:
            fail("invalid process identity")
        expected.append((pid, int(match.group(2))))
    expected = sorted(set(expected))
    pinned = []
    for pid, start_ticks in expected:
        current = process_identity(pid, uid)
        if current is None:
            continue
        if current != (pid, start_ticks):
            fail(f"PID {pid} no longer matches the approved process")
        try:
            pidfd = pidfd_open(pid)
        except ProcessLookupError:
            continue
        if process_identity(pid, uid) != (pid, start_ticks):
            os.close(pidfd)
            fail(f"PID {pid} changed while it was being approved")
        pinned.append(pidfd)
    signal_number = signal.SIGTERM if action == "term" else signal.SIGKILL
    for pidfd in pinned:
        try:
            pidfd_send_signal(pidfd, signal_number)
        except ProcessLookupError:
            pass
        finally:
            os.close(pidfd)
    print(f"STATUS=SIG{action.upper()}_SENT")


def main() -> None:
    if os.geteuid() != 0:
        fail("must run as root")
    if len(sys.argv) < 4:
        fail("usage: helper inspect|term|kill username process...")
    action, username, arguments = sys.argv[1], sys.argv[2], sys.argv[3:]
    if action == "inspect":
        inspect(username, arguments)
    elif action in {"term", "kill"}:
        send_signal(action, username, arguments)
    else:
        fail("invalid action")


if __name__ == "__main__":
    main()
