#!/usr/bin/python3
from __future__ import annotations

import json
import fcntl
import os
import shutil
import stat
import subprocess
import sys
import time


def fail(message: str, code: int = 2) -> None:
    print(message, file=sys.stderr)
    raise SystemExit(code)


def zfs_filesystem_usage(source: str) -> dict[str, int] | None:
    try:
        completed = run(
            ["zfs", "list", "-H", "-p", "-o", "used,avail", source],
            timeout=15,
        )
    except (OSError, subprocess.TimeoutExpired):
        return None
    fields = completed.stdout.split()
    if completed.returncode != 0 or len(fields) != 2 or not all(
        value.isdigit() for value in fields
    ):
        return None
    used, available = (int(value) for value in fields)
    return {
        "used_bytes": used,
        "available_bytes": available,
        "total_bytes": used + available,
    }


def filesystem_summary() -> None:
    filesystems: dict[int, dict[str, object]] = {}
    for path in ("/", "/home"):
        if not os.path.exists(path):
            continue
        device = os.stat(path).st_dev
        row = filesystems.setdefault(device, {"key": f"dev:{device}", "paths": []})
        row["paths"].append(path)
        stats = os.statvfs(path)
        row.update(
            {
                "total_bytes": stats.f_blocks * stats.f_frsize,
                "used_bytes": (stats.f_blocks - stats.f_bfree) * stats.f_frsize,
                "available_bytes": stats.f_bavail * stats.f_frsize,
                "total_inodes": stats.f_files,
                "free_inodes": stats.f_favail,
            }
        )
        try:
            mount = run(["findmnt", "-n", "-o", "FSTYPE,SOURCE", "-T", path])
        except (OSError, subprocess.TimeoutExpired):
            mount = None
        if mount is not None and mount.returncode == 0:
            fields = mount.stdout.split()
            if len(fields) >= 2 and fields[0] == "zfs":
                zfs_usage = zfs_filesystem_usage(fields[1])
                if zfs_usage is not None:
                    row.update(zfs_usage)
    print(json.dumps({"filesystems": list(filesystems.values())}))


def run(command: list[str], timeout: int = 30) -> subprocess.CompletedProcess[str]:
    return subprocess.run(
        command,
        capture_output=True,
        text=True,
        timeout=timeout,
        check=False,
    )


def top_home_zfs(source: str) -> list[dict[str, object]] | None:
    try:
        completed = run(
            [
                "zfs",
                "list",
                "-H",
                "-p",
                "-r",
                "-d",
                "1",
                "-o",
                "mountpoint,used",
                source,
            ],
            timeout=15,
        )
    except (OSError, subprocess.TimeoutExpired):
        return None
    if completed.returncode != 0:
        return None
    directories = []
    for line in completed.stdout.splitlines():
        path, separator, size = line.partition("\t")
        if (
            separator
            and path.startswith("/home/")
            and path.count("/") == 2
            and size.isdigit()
        ):
            directories.append({"path": path, "size_bytes": int(size)})
    return directories


def top_home_quota() -> list[dict[str, object]] | None:
    if shutil.which("repquota") is None:
        return None
    try:
        completed = run(["repquota", "-up", "/home"], timeout=20)
    except (OSError, subprocess.TimeoutExpired):
        return None
    if completed.returncode != 0:
        return None
    directories = []
    for line in completed.stdout.splitlines():
        fields = line.split()
        if len(fields) < 4 or fields[1] not in {"--", "+-", "-+", "++"}:
            continue
        username = fields[0].lstrip("#")
        blocks = fields[2]
        if not username or not blocks.isdigit():
            continue
        path = f"/home/{username}"
        if os.path.isdir(path):
            directories.append(
                {"path": path, "size_bytes": int(blocks) * 1024}
            )
    return directories


def top_home_cache(
    path: str = "/var/lib/hermes-home-scan/latest.tsv",
    *,
    now: int | None = None,
    expected_uid: int = 0,
    max_age_seconds: int = 48 * 3600,
    max_bytes: int = 1024 * 1024,
) -> list[dict[str, object]] | None:
    directories = []
    try:
        current_time = int(time.time()) if now is None else now
        parent = os.stat(os.path.dirname(path), follow_symlinks=False)
        metadata = os.lstat(path)
        if (
            not stat.S_ISDIR(parent.st_mode)
            or parent.st_uid != expected_uid
            or parent.st_mode & 0o022
            or not stat.S_ISREG(metadata.st_mode)
            or metadata.st_uid != expected_uid
            or metadata.st_mode & 0o022
            or metadata.st_size > max_bytes
            or current_time - int(metadata.st_mtime) > max_age_seconds
            or int(metadata.st_mtime) - current_time > 300
        ):
            return None
        descriptor = os.open(
            path,
            os.O_RDONLY | os.O_CLOEXEC | getattr(os, "O_NOFOLLOW", 0),
        )
        opened = os.fstat(descriptor)
        if (opened.st_dev, opened.st_ino) != (metadata.st_dev, metadata.st_ino):
            os.close(descriptor)
            return None
        with os.fdopen(descriptor, encoding="utf-8") as cache:
            for line_number, line in enumerate(cache, start=1):
                if line_number > 10000:
                    return None
                size, separator, home_path = line.rstrip("\n").partition("\t")
                if (
                    separator
                    and size.isdigit()
                    and home_path.startswith("/home/")
                    and home_path.count("/") == 2
                ):
                    directories.append(
                        {"path": home_path, "size_bytes": int(size)}
                    )
    except (OSError, UnicodeError, ValueError):
        return None
    directories.sort(key=lambda item: int(item["size_bytes"]), reverse=True)
    return directories


def top_home() -> None:
    if not os.path.isdir("/home"):
        print('{"directories": [], "source": "missing"}')
        return
    try:
        mount = run(["findmnt", "-n", "-o", "FSTYPE,SOURCE", "-T", "/home"])
    except (OSError, subprocess.TimeoutExpired):
        mount = None
    directories = None
    source_name = "unavailable"
    if mount is not None and mount.returncode == 0:
        fields = mount.stdout.split()
        if len(fields) >= 2 and fields[0] == "zfs":
            directories = top_home_zfs(fields[1])
            source_name = "zfs"
    if directories is None:
        directories = top_home_quota()
        if directories:
            source_name = "quota"
        else:
            directories = None
    if directories is None:
        directories = top_home_cache()
        if directories is not None:
            source_name = "cache"
    if directories is None:
        directories = []
    directories.sort(key=lambda item: int(item["size_bytes"]), reverse=True)
    print(json.dumps({"directories": directories[:10], "source": source_name}))


def available_bytes(path: str) -> int:
    stats = os.statvfs(path)
    return stats.f_bavail * stats.f_frsize


def cleanup_step(name: str, command: list[str], timeout: int) -> dict[str, object]:
    before = available_bytes("/")
    try:
        completed = run(command, timeout=timeout)
        status = "ok" if completed.returncode == 0 else "error"
    except subprocess.TimeoutExpired:
        status = "timeout"
    except OSError:
        status = "error"
    after = available_bytes("/")
    return {
        "name": name,
        "freed_bytes": max(0, after - before),
        "status": status,
    }


def cleanup_root(lock_path: str = "/run/hermes-disk-cleanup.lock") -> None:
    with open(lock_path, "w", encoding="utf-8") as lock:
        before = available_bytes("/")
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            print(
                json.dumps(
                    {
                        "before_available_bytes": before,
                        "after_available_bytes": before,
                        "actions": [
                            {
                                "name": "Безопасная очистка",
                                "freed_bytes": 0,
                                "status": "busy",
                            }
                        ],
                    }
                )
            )
            return
        actions = []
        if shutil.which("journalctl"):
            actions.append(
                cleanup_step(
                    "Ротация системных журналов",
                    ["journalctl", "--rotate"],
                    10,
                )
            )
            actions.append(
                cleanup_step(
                    "Архивные системные журналы",
                    ["journalctl", "--vacuum-size=200M"],
                    20,
                )
            )
        if shutil.which("apt-get"):
            actions.append(
                cleanup_step("Кеш apt", ["apt-get", "clean"], 30)
            )
        policy = "/etc/tmpfiles.d/hermes-disk-cleanup.conf"
        if shutil.which("systemd-tmpfiles") and os.path.isfile(policy):
            actions.append(
                cleanup_step(
                    "Временные файлы старше 14 дней",
                    ["systemd-tmpfiles", "--clean", policy],
                    30,
                )
            )
        after = available_bytes("/")
        print(
            json.dumps(
                {
                    "before_available_bytes": before,
                    "after_available_bytes": after,
                    "actions": actions,
                }
            )
        )


def main() -> None:
    if os.geteuid() != 0:
        fail("must run as root")
    if len(sys.argv) != 2 or sys.argv[1] not in {
        "summary",
        "top-home",
        "cleanup-root",
    }:
        fail("usage: hermes-disk-report summary|top-home|cleanup-root", 64)
    if sys.argv[1] == "summary":
        filesystem_summary()
    elif sys.argv[1] == "top-home":
        top_home()
    else:
        cleanup_root()


if __name__ == "__main__":
    main()
