#!/usr/bin/python3
import json
import os
import subprocess
import sys


def fail(message: str, code: int = 2) -> None:
    print(message, file=sys.stderr)
    raise SystemExit(code)


def filesystem_summary() -> None:
    filesystems: dict[int, dict[str, object]] = {}
    for path in ("/", "/home"):
        if not os.path.exists(path):
            continue
        device = os.stat(path).st_dev
        row = filesystems.setdefault(device, {"key": f"dev:{device}", "paths": []})
        row["paths"].append(path)
        stats = os.statvfs(path)
        row.update(
            {
                "total_bytes": stats.f_blocks * stats.f_frsize,
                "used_bytes": (stats.f_blocks - stats.f_bfree) * stats.f_frsize,
                "available_bytes": stats.f_bavail * stats.f_frsize,
                "total_inodes": stats.f_files,
                "free_inodes": stats.f_favail,
            }
        )
    print(json.dumps({"filesystems": list(filesystems.values())}))


def top_home() -> None:
    if not os.path.isdir("/home"):
        print('{"directories": []}')
        return
    paths = [entry.path for entry in os.scandir("/home") if entry.is_dir(follow_symlinks=False)]
    if not paths:
        print('{"directories": []}')
        return
    try:
        completed = subprocess.run(
            ["du", "-x", "-B1", "-s", "--", *paths],
            capture_output=True,
            text=True,
            timeout=120,
            check=False,
        )
    except subprocess.TimeoutExpired:
        fail("du timed out")
    directories = []
    for line in completed.stdout.splitlines():
        size, separator, path = line.partition("\t")
        if separator and size.isdigit() and path in paths:
            directories.append({"path": path, "size_bytes": int(size)})
    directories.sort(key=lambda item: int(item["size_bytes"]), reverse=True)
    print(json.dumps({"directories": directories[:5]}))


def main() -> None:
    if os.geteuid() != 0:
        fail("must run as root")
    if len(sys.argv) != 2 or sys.argv[1] not in {"summary", "top-home"}:
        fail("usage: hermes-disk-report summary|top-home", 64)
    if sys.argv[1] == "summary":
        filesystem_summary()
    else:
        top_home()


if __name__ == "__main__":
    main()
